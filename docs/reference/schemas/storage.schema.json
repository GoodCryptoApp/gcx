{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gcx.ai/schemas/storage.schema.json",
  "title": "Storage",
  "description": "GET /api/v1/runtime/storage (decision 0031 d13 to d16): how much disk the data folder takes, by part, and the history (the database) by account and by month. The folder's parts are counted on each request; the history's figures are an estimate, counted in the background while the page asks (`?count=0` asks for the folder alone and starts no count): each is its share of the journal's rows × the database's used pages, so they add up. Byte counts are whole numbers. Additions to /api/v1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "state",
    "seq",
    "at",
    "folder",
    "accounts",
    "shared",
    "months",
    "free",
    "compacted",
    "trafficSince"
  ],
  "properties": {
    "state": {
      "enum": [
        "counting",
        "ready"
      ],
      "description": "`counting` until the first count reaches the end of the journal; `ready` after (the figures then follow the journal with each request)."
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "description": "The last journal row counted."
    },
    "at": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "When the count last reached the end of the journal (ms since the epoch); null before the first."
    },
    "folder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bytes",
        "parts"
      ],
      "properties": {
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "parts": {
          "type": "array",
          "description": "In this order: history (the database and its log), logs, updates (downloads), backups (before updates), reserve (kept free for a full disk), other (keys, settings).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "part",
              "bytes"
            ],
            "properties": {
              "part": {
                "enum": [
                  "history",
                  "logs",
                  "updates",
                  "backups",
                  "reserve",
                  "other"
                ]
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "accounts": {
      "type": "array",
      "description": "The history by account, in the order the accounts were added. An account removed with its trading history deleted is not listed; its rows are in `shared` until erased.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "label",
          "address",
          "removed",
          "bytes",
          "groups"
        ],
        "properties": {
          "sourceId": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "removed": {
            "type": "boolean",
            "description": "Being removed, or removed with its history kept."
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "groups": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "orders",
              "bots",
              "funding",
              "account"
            ],
            "description": "The parts of `bytes`: orders and trades, bots, funding, and the account's own records.",
            "properties": {
              "orders": {
                "type": "integer",
                "minimum": 0
              },
              "bots": {
                "type": "integer",
                "minimum": 0
              },
              "funding": {
                "type": "integer",
                "minimum": 0
              },
              "account": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "shared": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bytes"
      ],
      "properties": {
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "description": "No account's: prices gcx acted on and gcx's own records."
    },
    "months": {
      "type": "array",
      "description": "The history by month of the row's own time (UTC): the last twelve, oldest first, then `earlier`.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "month",
          "bytes"
        ],
        "properties": {
          "month": {
            "type": "string",
            "pattern": "^([0-9]{4}-[0-9]{2}|earlier)$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "free": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bytes"
      ],
      "properties": {
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "description": "Free inside the database: reused by new history, the file does not shrink."
    },
    "compacted": {
      "type": "array",
      "description": "Each deletion of an account's data, from its marker in the journal: when, how many rows, and the accounts' ids (no name, no address).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "at",
          "rows",
          "sources"
        ],
        "properties": {
          "at": {
            "type": "integer",
            "minimum": 0
          },
          "rows": {
            "type": "integer",
            "minimum": 0
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "trafficSince": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "Added by 0020 amendment 1: the start (ms, a UTC hour) of the oldest hour the exchange traffic log (`wire/`) still holds, null when it holds none. Less than 7 days back when the Logs size set in Settings › Storage is reached first."
    },
    "years": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "year",
          "bytes"
        ],
        "properties": {
          "year": {
            "type": "string",
            "pattern": "^[0-9]{4}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  },
  "$defs": {
    "erase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "before": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
        }
      },
      "oneOf": [
        {
          "required": [
            "sourceId"
          ],
          "not": {
            "required": [
              "before"
            ]
          }
        },
        {
          "required": [
            "before"
          ],
          "not": {
            "required": [
              "sourceId"
            ]
          }
        }
      ]
    }
  }
}
