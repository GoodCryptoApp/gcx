{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gcx.ai/schemas/affiliate-api.schema.json",
  "title": "Referral program routes",
  "description": "The routes of Settings \u203a Referral program (decision 0021 S1; docs/referral-program.md): this gcx's one partner code, and a partner's own key. Every read is any access key's (API-MCP-320), the partner key itself (GET /api/v1/partner) excepted; every action is a signed-in person's only. All are additions to /api/v1; a runtime with no partner signing key built in answers 404. Percentages are decimal strings.",
  "$defs": {
    "join": {
      "description": "POST /api/v1/referral: a friend's referral code (gcx- and eight characters: gcx-7K3MQ2AD; case and whitespace around it do not matter) or a partner's code, as pasted. A referral code is sent to goodcryptoX's server, which knows the installation that shared it and the split; it is stored from the server's answer only (the join it holds, also when it refuses a second code), once, never changed or removed. A partner's code is verified offline against our key. 422 {error: \"Invalid code\"} or {error: \"You can't refer yourself\"}; 409 {error: \"You're already referred\"} or {error: \"Available in a few minutes\"}; 503 {error: \"unreachable\"} when the server gave no answer (nothing is stored; send it again). Internal startup tier: the same checks; this installation's own code is accepted as separate local test metadata, without fee or server effects.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "install": {
      "description": "POST /api/v1/partner: a partner key, as pasted. Valid when every code in it verifies against our key; it replaces the one stored. 422 {error: \"Invalid key\"}. Internal startup tier accepts the exact typed text as a separate local sample key, without verification or server effects.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key"
      ],
      "properties": {
        "key": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "referral": {
      "description": "GET /api/v1/referral, and the answer of POST: the code this gcx joined with and what it changes. Without a code: code null, discount \"0\", fee \"0.03\", since null.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "discount",
        "fee",
        "since"
      ],
      "properties": {
        "code": {
          "type": [
            "string",
            "null"
          ],
          "description": "The code's text (a referral code, gcx-7K3MQ2AD, or a partner's code); null before one is entered."
        },
        "discount": {
          "type": "string",
          "pattern": "^(0|5|10|20|30|40|50)$",
          "description": "The discount on gcx's fee the code gives, a percent of the fee."
        },
        "fee": {
          "type": "string",
          "pattern": "^0\\.0[0-9]+$",
          "description": "gcx's builder fee on every order from the next one on, a percent of the trade (0.03 without a code, 0.027 with a 10% code)."
        },
        "since": {
          "type": [
            "integer",
            "null"
          ],
          "description": "When the code was entered (Unix ms); null before."
        },
        "test": {
          "type": "boolean",
          "description": "True only for an internal local test overlay; no effect on actual fees. Absent on older builds."
        },
        "codes": {
          "$ref": "#/$defs/codes/properties/codes",
          "description": "Additive (API-MCP-320), GET only: this installation's own three codes, as GET /api/v1/referral/codes answers them; absent where they are not derived, and from an older version."
        }
      }
    },
    "partner": {
      "description": "GET /api/v1/partner, and the answer of POST: this gcx's partner key, or {key: null} when none is installed.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key"
          ],
          "properties": {
            "key": {
              "type": "null"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "max",
            "valid",
            "codes",
            "key"
          ],
          "properties": {
            "id": {
              "type": "string",
              "description": "The partner number."
            },
            "max": {
              "type": "string",
              "pattern": "^(10|20|30|40|50)$",
              "description": "His maximum share, a percent of gcx's fee."
            },
            "valid": {
              "type": "boolean",
              "description": "False when the key was made under a signing key this version no longer trusts (a rotation): no code is shown; ask goodcryptoX for a new key."
            },
            "codes": {
              "type": "array",
              "description": "One code per discount from 0 to the maximum in 10% steps; empty when not valid.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "discount",
                  "code"
                ],
                "properties": {
                  "discount": {
                    "type": "string",
                    "pattern": "^(0|10|20|30|40|50)$"
                  },
                  "code": {
                    "type": "string"
                  }
                }
              }
            },
            "key": {
              "type": "string",
              "description": "The partner key's text, for Copy partner key."
            },
            "test": {
              "type": "boolean",
              "description": "Internal local sample key only; never a verified server key."
            },
            "payouts": {
              "enum": [
                "here",
                "elsewhere"
              ],
              "description": "The last acknowledged partner-key answer, retained across restart; absent before an answer"
            }
          },
          "allOf": [
            {
              "if": {
                "required": [
                  "test"
                ],
                "properties": {
                  "test": {
                    "const": true
                  }
                }
              },
              "then": {
                "properties": {
                  "id": {
                    "const": "test"
                  }
                }
              },
              "else": {
                "properties": {
                  "id": {
                    "pattern": "^[0-9a-f]{16}$"
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "figures": {
      "description": "GET /api/v1/partner/figures (decision 0021 amendment 4 d6): per code of the stored partner key, read from goodcryptoX's partner-code server, at most once a minute and only when the page asks. 404 with no key that verifies, the internal test key, no server, or a server that does not serve figures yet; 503 {error} when the server cannot be read and nothing is kept. Counts and sums only: nothing names an installation, an address or an account.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at",
        "stale",
        "through",
        "codes"
      ],
      "properties": {
        "through": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "The last UTC day the volume is counted through (ruling 108 (a)); null before any day is counted."
        },
        "at": {
          "type": "integer",
          "description": "When the server's answer was received (Unix ms)."
        },
        "stale": {
          "type": "boolean",
          "description": "True when the server could not be read now and the last answer received is served."
        },
        "codes": {
          "type": "array",
          "description": "One entry per discount from 0 to the key's maximum, in order.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "discount",
              "joined",
              "trading",
              "volume"
            ],
            "properties": {
              "discount": {
                "type": "string",
                "pattern": "^(0|10|20|30|40|50)$",
                "description": "The code's discount, a percent of gcx's fee (as GET /api/v1/partner names it)."
              },
              "joined": {
                "type": "integer",
                "minimum": 0,
                "description": "Users who joined with this code."
              },
              "trading": {
                "type": "integer",
                "minimum": 0,
                "description": "Traded: of those, the ones whose orders ever reached the server, since the start (decision 0053 amendment 1)."
              },
              "volume": {
                "type": "array",
                "description": "This week's paid volume per unit, a day or two behind (the trades that pay, as goodcryptoX counts them to pay); empty when none. The main collateral first, then by name.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "unit",
                    "amount"
                  ],
                  "properties": {
                    "unit": {
                      "type": "string"
                    },
                    "amount": {
                      "type": "string",
                      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
                      "description": "The exact decimal sum."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "clear": {
      "description": "C77: internal-only local test reset. No permanent referral, installation/report or fee record is rewritten.",
      "type": "object",
      "additionalProperties": false
    },
    "destinationSave": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network",
        "address",
        "expectedRevision"
      ],
      "properties": {
        "network": {
          "enum": [
            "arbitrum",
            "base",
            "optimism",
            "polygon",
            "bsc",
            "avalanche",
            "solana"
          ]
        },
        "address": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740990
        }
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network",
        "address",
        "revision"
      ],
      "properties": {
        "network": {
          "type": [
            "string",
            "null"
          ]
        },
        "address": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "codes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codes"
      ],
      "properties": {
        "codes": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "discount",
              "code"
            ],
            "properties": {
              "discount": {
                "enum": [
                  "0",
                  "5",
                  "10"
                ]
              },
              "code": {
                "type": "string",
                "pattern": "^gcx-[0-9A-HJKMNP-TV-Z]{8}$",
                "description": "The code to share (decision 0053 amendment 1): gcx- and 8 Crockford base32 characters goodcryptoX's server minted for this installation and this split; kept from the server's last answer."
              }
            }
          }
        }
      }
    },
    "earnings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "earned",
        "paid",
        "unpaid",
        "stale",
        "joined"
      ],
      "properties": {
        "earned": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "paid": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "unpaid": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "stale": {
          "type": "boolean"
        },
        "joined": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "discountPct",
              "joined"
            ],
            "properties": {
              "discountPct": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
              },
              "joined": {
                "type": "integer",
                "minimum": 0
              },
              "trading": {
                "type": "integer",
                "minimum": 0,
                "description": "Traded: of those who joined with this code, the ones who ever placed an order, since the start (decision 0053 amendment 1)."
              },
              "volume": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "unit",
                    "amount"
                  ],
                  "properties": {
                    "unit": {
                      "type": "string",
                      "minLength": 1
                    },
                    "amount": {
                      "type": "string",
                      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                    }
                  }
                }
              }
            }
          }
        },
        "through": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "payout": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "amount",
            "state",
            "destination",
            "payment"
          ],
          "properties": {
            "amount": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            },
            "state": {
              "enum": [
                "requested",
                "paid",
                "cancelled"
              ]
            },
            "destination": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "network",
                "address"
              ],
              "properties": {
                "network": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "address": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "payment": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "amount",
                    "tx"
                  ],
                  "properties": {
                    "amount": {
                      "type": "string",
                      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                    },
                    "tx": {
                      "type": "string"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    }
  }
}
